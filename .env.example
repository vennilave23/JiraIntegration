# JiraIntegration configuration
# Copy this file to .env and replace values with your Jira/Confluence credentials.

JIRA_BASE_URL=https://murthyrajender.atlassian.net
JIRA_API_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token

# Optional OAuth2 settings; not required if using API email + token
JIRA_TOKEN_URL=https://auth.atlassian.com/oauth/token
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

CONFLUENCE_BASE_URL=https://murthyrajender.atlassian.net/wiki
CONFLUENCE_API_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your-api-token

# Optional OAuth2 settings for Confluence
CONFLUENCE_TOKEN_URL=https://auth.atlassian.com/oauth/token
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=

# Local database URL; leave default for project-local SQLite
DB_URL=sqlite:///data.db
